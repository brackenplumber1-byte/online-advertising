# Copy to .env and fill in only the platforms you've set up so far.
# Leave a platform's vars unset to have the skill fall back to draft-only
# mode for that platform. Never commit the real .env.

# --- Meta (Facebook + Instagram) — see references/meta.md ---
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=

# --- LinkedIn — see references/linkedin.md ---
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
# LINKEDIN_API_VERSION=202601

# --- Google Business Profile — see references/gbp.md ---
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

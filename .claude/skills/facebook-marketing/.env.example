# Copy this file to .env and fill in your own values.
# Get FB_APP_ID / FB_APP_SECRET by creating an app at
# https://developers.facebook.com/apps — add the "Facebook Login" and
# "Marketing API" products, and set the OAuth redirect URI to
# http://localhost:8765/callback (or whatever --port you use).

# Required for facebook_login.py (OAuth login + token exchange).
FB_APP_ID=your_app_id
FB_APP_SECRET=your_app_secret

# Optional: skip `facebook_login.py --action login` by supplying tokens
# directly. A Page token is enough for facebook_post.py; ads need a
# user token with ads_management scope.
# FB_PAGE_ACCESS_TOKEN=
# FB_USER_ACCESS_TOKEN=
# FB_ACCESS_TOKEN=

# Optional defaults so you don't have to pass --page-id / --ad-account-id
# on every command.
# FB_PAGE_ID=1234567890
# FB_AD_ACCOUNT_ID=1234567890   # with or without the "act_" prefix

# Graph API version. Bump this if calls start failing with a
# deprecation error — see https://developers.facebook.com/docs/graph-api/changelog
# FB_API_VERSION=v21.0

# Optional: where to keep the OAuth token cache.
# Defaults to ~/.facebook on Mac/Linux, %USERPROFILE%\.facebook on Windows.
# FACEBOOK_HOME=/Users/yourname/.facebook

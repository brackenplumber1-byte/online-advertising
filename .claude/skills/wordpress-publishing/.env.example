# Copy this file to .env and fill in your details. Never commit the real .env.
WP_SITE_URL=https://brackendownsplumber.co.za
WP_USERNAME=your-wp-username
# Generate at wp-admin -> Users -> Profile -> Application Passwords.
# It looks like "abcd EFGH ijkl MNOP qrst UVWX" — spaces included are fine.
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# ── Anthropic ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5

# ── Meta / Graph API ─────────────────────────────────────────────────────
# Create an app at https://developers.facebook.com/apps, add the
# "Facebook Login for Business", "Webhooks", "Instagram Graph API" and
# "Messenger" products. See README.md for the full walkthrough.
GRAPH_API_VERSION=v21.0

# Page-scoped access token (long-lived, from a System User in Business
# Manager is recommended so it doesn't expire every 60 days).
PAGE_ACCESS_TOKEN=
PAGE_ID=

# Instagram professional (business/creator) account linked to the Page above.
IG_USER_ID=

# App secret, used to verify X-Hub-Signature-256 on incoming webhooks.
APP_SECRET=

# Arbitrary string you choose; must match the "Verify Token" you enter in
# the Meta App Dashboard webhook subscription screen.
WEBHOOK_VERIFY_TOKEN=change-me

# ── Safety switches ──────────────────────────────────────────────────────
# When "false" (default), incoming comments/DMs get a Claude-drafted reply
# that is only logged/queued for a human to approve — nothing is posted to
# the live page automatically. Flip to "true" only once you trust the
# brand voice and lead-detection output.
AUTO_SEND_REPLIES=false

# ── Business facts (used as ground truth in every generated caption/reply
#    so Claude never invents phone numbers, hours, or service areas) ──────
BUSINESS_NAME=247 Plumbers
BUSINESS_PHONE=
BUSINESS_WEBSITE=
SERVICE_AREA=
BUSINESS_HOURS=24/7 emergency service

# ── Lead notifications (optional) ────────────────────────────────────────
# Leave blank to skip email notification and just log to leads/leads.jsonl.
LEADS_NOTIFY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
